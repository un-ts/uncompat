{
  "name": "@uncompat/oxc-resolver",
  "version": "0.0.0",
  "type": "module",
  "description": "Node-compatible module resolution on top of oxc-resolver",
  "repository": "git+https://github.com/un-ts/uncompat.git",
  "homepage": "https://github.com/un-ts/uncompat/blob/main/packages/oxc-resolver",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "funding": "https://opencollective.com/unts",
  "license": "MIT",
  "exports": "./src/index.ts",
  "files": [
    "lib"
  ],
  "dependencies": {
    "oxc-resolver": "^11.24.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./lib/index.cjs",
    "types": "./lib/index.d.cts",
    "module": "./lib/index.js",
    "exports": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "module-sync": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">= 14"
  }
}
